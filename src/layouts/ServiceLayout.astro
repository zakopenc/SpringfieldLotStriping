---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
}

const { title, description, h1 } = Astro.props;
const siteUrl = Astro.site?.toString() ?? 'https://www.springfieldlotstriping.com';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: h1,
  description,
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}#business`,
    name: 'Springfield Lot Striping',
    url: siteUrl
  },
  areaServed: [
    'Springfield, MO',
    'Nixa, MO',
    'Ozark, MO',
    'Republic, MO',
    'Battlefield, MO',
    'Rogersville, MO',
    'Greene County, MO'
  ],
  url: new URL(path, siteUrl).toString()
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: h1, item: new URL(path, siteUrl).toString() }
  ]
};
---

<BaseLayout {title} {description}>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <div class="pt-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 py-16">
      <h1 class="text-5xl font-bold text-primary-dark mb-8">{h1}</h1>
      <div class="stripe-divider w-20 h-1 bg-brand-yellow mb-12"></div>

      <slot />

      <section class="mt-14 grid gap-8 lg:grid-cols-3 not-prose">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-2xl font-semibold text-primary-dark mb-3">Built for Springfield-area commercial properties</h2>
          <p class="text-concrete leading-relaxed">Springfield, Nixa, Ozark, Republic, Battlefield, and Rogersville properties deal with heavy summer sun, freeze-thaw cycles, rain, and tracking from busy entrances. A useful striping plan accounts for traffic flow, drainage, loading activity, and the way customers and delivery drivers actually move through the site.</p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-2xl font-semibold text-primary-dark mb-3">A documented quote process</h2>
          <ol class="space-y-3 text-concrete leading-relaxed list-decimal list-inside">
            <li>Share the property address, approximate lot size, and the markings that need attention.</li>
            <li>Review traffic flow, ADA spaces, fire lanes, loading zones, and problem areas.</li>
            <li>Receive a written scope with scheduling options designed to limit disruption.</li>
            <li>Keep project photos and measurements with your property maintenance records.</li>
          </ol>
        </div>
        <div class="rounded-2xl border border-brand-yellow/40 bg-brand-yellow/10 p-6">
          <h2 class="text-2xl font-semibold text-primary-dark mb-3">Explore related services</h2>
          <p class="text-concrete leading-relaxed mb-4">Many properties need more than one marking category during the same maintenance cycle.</p>
          <div class="flex flex-wrap gap-2 text-sm font-semibold">
            <a class="underline hover:text-primary-dark" href="/services/parking-lot-striping/">Parking lots</a>
            <a class="underline hover:text-primary-dark" href="/services/ada-compliance-striping/">ADA markings</a>
            <a class="underline hover:text-primary-dark" href="/services/fire-lane-striping/">Fire lanes</a>
            <a class="underline hover:text-primary-dark" href="/services/warehouse-line-striping/">Warehouse lines</a>
            <a class="underline hover:text-primary-dark" href="/services/restriping/">Restriping</a>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="bg-primary-dark py-16 text-white text-center">
    <div class="max-w-2xl mx-auto px-6">
      <h2 class="text-4xl font-semibold mb-4">Ready for Professional Striping?</h2>
      <p class="text-xl mb-8 text-white/80">Get a free quote for your Springfield or Greene County property today.</p>
      <a href="/contact" class="btn-primary text-lg px-12 py-5 inline-block shadow-md hover:shadow-lg transition-all">Request Free Quote →</a>
    </div>
  </div>
</BaseLayout>
